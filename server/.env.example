PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kyro?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Ask for an email OTP on every login too (true/false). Sign-up always needs OTP.
LOGIN_OTP=true

# Gmail API (leave empty in development: OTP is then printed in the server console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=your.address@gmail.com

# Device (Web Push) notifications. Generate keys with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
